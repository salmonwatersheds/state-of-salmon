# Ignore R-specific memory files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Ignore all word docs
*.docx

# Ignore rendered methods-results doc, which may be large.
methods-results/*.html
code/*.html


# Old code files archived on local repos
code/archive
code/ignore

# Output files - these should be saved to Dropbox in the 'shadow repo'
output/ignore
output/archive
output/print-figures

# Original or sensitive data sources - these should be saved to Dropbox in the 'shadow repo'
data/sources
data/ignore

maps-figs/*.rds
maps-figs/*.svg
maps-figs/*.png
